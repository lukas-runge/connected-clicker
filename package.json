{
  "name": "connected-clicker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "contract:emit": "prisma-next contract emit",
    "db:init": "prisma-next db init",
    "db:update": "prisma-next db update",
    "db:verify": "prisma-next db verify",
    "migration:status": "prisma-next migration status",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.9.1",
    "prisma-next": "^0.11.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@prisma-next/postgres": "^0.11.0",
    "dotenv": "^17.4.2"
  },
  "description": "Connected Clicker: a connected visitor tracker for entrace and exit monitoring",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  }
}
